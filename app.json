{
  "expo": {
    "name": "Hairday",
    "slug": "hairday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hairday",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "bundleIdentifier": "app.hairday",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hairday",
      "adaptiveIcon": {
        "backgroundColor": "#171826",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171826",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hairday needs your photos so you can add pictures to your profile or review.",
          "cameraPermission": "Hairday uses the camera so you can take a photo for your profile or review.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hairday uses your location to show salons near you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Hairday imports the contacts you choose into your client list."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Hairday adds your appointment to your calendar.",
          "writeOnlyCalendarPermission": "Hairday adds your appointment to your calendar.",
          "writeOnlyAccess": true,
          "remindersPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#171826"
        }
      ],
      "./plugins/with-android-release.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "hasAndroidMapsKey": false,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cad9905b-7579-4911-b2b2-810d78a881ef"
      }
    },
    "owner": "hairday"
  }
}
