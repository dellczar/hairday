# Copy this file to .env and fill in the values. Never commit .env.
# Keys starting with EXPO_PUBLIC_ are built into the app and must be safe to share (public keys only).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=        # pk_test_... until launch
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=               # used in app.config.ts for react-native-maps on Android

# Server-only secrets — set these in Supabase (supabase secrets set ...), not in the app:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=
# GOOGLE_GEOCODING_API_KEY=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=   (only if SMS is turned on)
